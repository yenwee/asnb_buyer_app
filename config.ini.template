# ASNB Buyer - Configuration
# Copy this file to config.ini and fill in your details:
#   cp config.ini.template config.ini

[Settings]
# Global defaults - profiles can override any of these
funds_to_try = Amanah Saham Malaysia 2 Wawasan
purchase_amount = 100
bank_name = Public Bank
referral_code =
loop_tries = 0
# Check session health every N fund attempts; re-login only when unhealthy.
session_refresh_interval = 6
# Per-browser summed process-tree RSS, not total machine Chrome memory.
# Two readings >=60s apart above this limit schedule a restart, preferably in cooldown.
browser_memory_limit_mb = 3072
# Passive redacted request metadata; no API replay. Disable to avoid collection overhead.
network_trace = true
# Skip observed decorative hero banners; security images, logos, icons and FPX stay enabled.
lean_assets = true
# eager waits for DOM readiness; element/state checks still wait for the application.
# Set normal to restore waiting for all page resources.
page_load_strategy = eager
# Read-only API eligibility/operating-hours checks and uncertain-submission history.
# Disables optional API reads in UI mode only; API purchasing requires its metadata reads.
api_reads = true
# Wait longer for subscription responses; unknown outcomes still pause, never replay.
# Range: 20-180 seconds. Also accepts a per-profile override.
api_purchase_timeout_seconds = 60

[Email]
# SMTP settings for purchase notifications (shared across all profiles)
# Leave blank to disable email notifications
# Gmail: use smtp.gmail.com port 587 with an App Password
#   (Google Account > Security > 2-Step Verification > App passwords)
smtp_server =
smtp_port = 587
sender_email =
sender_password =
recipient_email =
send_on_success = true
send_on_failure = false
email_subject = ASNB Purchase Notification

# --- Profiles ---
# Each [Profile.xxx] section is one MyASNB account.
# Run with: make run P=xxx  or  python -m asnb.main --profile xxx
#
# Required: username, password
#   - username: your MyASNB login ID (e.g. asnb1234)
#   - password: your MyASNB password
#
# Optional overrides (falls back to [Settings] if not set):
#   security_phrase, bank_name, purchase_amount, funds_to_try, referral_code,
#   loop_tries, session_refresh_interval, recipient_email
#
# Available banks:
#   Affin Bank, Alliance Bank, AmBank, Bank Islam, Bank Rakyat,
#   Bank Muamalat, CIMB Clicks, Hong Leong Bank, HSBC Bank,
#   Maybank2U, Public Bank, RHB Bank, UOB Bank, BSN, KFH,
#   Maybank2E, OCBC Bank, Standard Chartered, AGRONet, Bank of China

# Example profile - rename and fill in your details:
[Profile.example]
username = asnb1234
password = MyP@ssw0rd123
security_phrase = my secret phrase
